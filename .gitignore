# ══════════════════════════════════════════════════════════
# .gitignore — Fichiers à ne PAS pusher sur GitHub
# ══════════════════════════════════════════════════════════

# ═══ Node.js ═══
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json

# ═══ Python ═══
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/

# ═══ Modèle ML (trop gros pour GitHub) ═══
ml-service/final_model/*.bin
ml-service/final_model/*.safetensors
ml-service/final_model/checkpoint-*/

# ═══ Environnement ═══
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ═══ IDE ═══
.vscode/
.idea/
*.swp
*.swo
*~

# ═══ OS ═══
.DS_Store
Thumbs.db

# ═══ Logs ═══
logs/
*.log

# ═══ Build ═══
frontend/build/
frontend/.next/
frontend/out/

# ═══ Divers ═══
.cache/
.temp/
tmp/