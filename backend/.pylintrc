[MASTER]
extension-pkg-allow-list=
jobs=1

[MESSAGES CONTROL]
disable=
    C0111,
    R0903,
    C0103,
    W0212,
    R0913,
    R0914

[FORMAT]
max-line-length=100
indent-string='    '
max-module-lines=1000

[BASIC]
variable-rgx=[a-z_][a-z0-9_]{0,30}$
const-rgx=(([A-Z_][A-Z0-9_]*)|(__.*__))$
function-rgx=[a-z_][a-z0-9_]{2,40}$
class-rgx=[A-Z_][a-zA-Z0-9]+$

[DESIGN]
max-args=7
max-attributes=10

[SIMILARITIES]
min-similarity-lines=4
ignore-comments=yes
ignore-docstrings=yes

[REPORTS]
output-format=text
reports=yes
score=yes